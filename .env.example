# Panel admin (solo servidor; nunca uses NEXT_PUBLIC_ para la contraseña)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=tu-password-admin-seguro

#SUPABASE
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-supabase-service-role-key

#GEOAPIFY
NEXT_PUBLIC_GEOAPIFY_API_KEY=tu-geoapify-api-key

# Flow Payment Gateway
# Sandbox (pruebas): https://sandbox.flow.cl/api
# Producción:        https://www.flow.cl/api
FLOW_API_KEY=tu-flow-api-key
FLOW_SECRET_KEY=tu-flow-secret-key
FLOW_API_URL=https://sandbox.flow.cl/api

# Application URL (para callbacks de Flow)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# n8n - Webhook que envía el correo de cotización (SMTP lo maneja n8n, no el sitio)
N8N_QUOTE_WEBHOOK_URL=https://core.zensus.cl/webhook/tu-webhook-id

# Correo del dueño/admin al que se avisa cuando se aprueba un pago (evento
# "payment_approved" del mismo webhook de n8n de arriba). Requiere agregar en el
# workflow de n8n una rama que envíe un correo cuando event === "payment_approved".
ADMIN_NOTIFICATION_EMAIL=contacto@yomeencargo.cl

# Tracking (GTM y Meta Pixel)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXX

# n8n - Calendario del panel admin (SOLO LECTURA de los Google Calendar de Tomás).
# Workflow "YoMeEncargo · Calendario admin" (id 2WB9CFxqxlDtRecC) en core.zensus.cl.
# Sin estas dos variables el calendario funciona igual, pero solo con las reservas.
N8N_CALENDAR_WEBHOOK_URL=https://core.zensus.cl/webhook/tu-webhook-id
N8N_CALENDAR_TOKEN=tu-token-compartido-con-el-workflow

# Facturación con Emisso Connect (https://connect.emisso.ai). Solo servidor: nunca NEXT_PUBLIC_.
# La key necesita los permisos sii:read y sii:write. La conexión (conn_...) es la empresa
# a cuyo nombre se emite. Sin estas dos variables el panel muestra «no configurado».
EMISSO_CONNECT_API_KEY=
EMISSO_CONNECTION_ID=

# Correos del sistema: envío DIRECTO con Resend, sin n8n.
# Con RESEND_API_KEY cargada, TODOS los correos (cotización, comprobantes, recordatorios,
# link de ingreso, avisos a trabajadores) salen por Resend desde el código. Sin ella, los
# correos a clientes siguen por el webhook de n8n y los avisos a trabajadores no salen.
# RESEND_FROM es opcional: por defecto «Yo me Encargo <contacto@yomeencargo.cl>».
RESEND_API_KEY=
RESEND_FROM=



# Asistente de WhatsApp (Cloud API de Meta). Solo en el servidor: ninguna lleva NEXT_PUBLIC_.
# WHATSAPP_BOT_ENABLED=true lo enciende; con cualquier otro valor el webhook recibe y no responde.
WHATSAPP_BOT_ENABLED=false
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
# El asistente interpreta los mensajes y las fotos con OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=
